# ==============================================================================
# LogPilot - Environment Configuration Template
# Copy this file to .env and adjust variables as needed. Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker Compose Profile & Resource Allocation
# Choose 'full' (16 GB RAM recommended) or 'lite' (8 GB RAM recommended)
# ------------------------------------------------------------------------------
COMPOSE_PROFILES=full

# Container Memory Limits (Full Profile defaults)
# For Lite Profile (8 GB total):
#   ES_MEM_LIMIT=1536m, ES_JAVA_OPTS=-Xms1g -Xmx1g
#   KAFKA_MEM_LIMIT=768m
#   KIBANA_MEM_LIMIT=768m
#   REDIS_MEM_LIMIT=128m
ES_MEM_LIMIT=3g
KAFKA_MEM_LIMIT=1g
KIBANA_MEM_LIMIT=1g
REDIS_MEM_LIMIT=256m

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft mode)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_BOOTSTRAP_SERVERS=kafka:9092

# Kafka Topics
KAFKA_TOPIC_RAW=logs.raw
KAFKA_TOPIC_PARSED=logs.parsed
KAFKA_TOPIC_METRICS=metrics.windows
KAFKA_TOPIC_ANOMALIES=anomalies
KAFKA_TOPIC_INCIDENTS=incidents.events

# ------------------------------------------------------------------------------
# Elasticsearch & Kibana
# ------------------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INTERNAL_URL=http://elasticsearch:9200
ELASTIC_VERSION=8.11.0
ELASTIC_PASSWORD=changeme
ELASTIC_USER=elastic

# Heap allocations (Full: 2g, Lite: 1g)
ES_JAVA_OPTS=-Xms2g -Xmx2g

KIBANA_PORT=5601
KIBANA_URL=http://localhost:5601

# Elasticsearch Indices
ES_INDEX_LOGS=logs
ES_INDEX_METRICS=metrics-windows
ES_INDEX_INCIDENTS=incidents
ES_INDEX_RAG_CHUNKS=rag-chunks
ES_INDEX_CHAT_HISTORY=chat-history

# ------------------------------------------------------------------------------
# Redis (Speed layer: live state, active incidents, semantic cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_INTERNAL_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Apache Spark (Streaming & Batch)
# ------------------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=/tmp/spark-checkpoints
SPARK_WATERMARK_DURATION=2 minutes
SPARK_WINDOW_DURATION=1 minute
SPARK_SLIDING_DURATION=5 minutes
ANOMALY_ZSCORE_THRESHOLD=3.0

# ------------------------------------------------------------------------------
# RAG Copilot & LLM Settings
# ------------------------------------------------------------------------------
# LLM Provider: 'groq' (default, free tier) or 'ollama' (offline fallback)
LLM_PROVIDER=groq

# Groq API configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama configuration (offline fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Sentence-Transformers embedding model (runs locally on CPU, 384 dimensions)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Semantic cache threshold in Redis (cosine similarity threshold)
SEMANTIC_CACHE_THRESHOLD=0.92

# ------------------------------------------------------------------------------
# Microservices & Web Ports
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=8000
ORDERS_PORT=8001
PAYMENTS_PORT=8002
INVENTORY_PORT=8003

COPILOT_API_PORT=5000
COPILOT_FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Replay Service Settings
# ------------------------------------------------------------------------------
REPLAY_SPEED=1.0
REPLAY_DATASET_PATH=data/loghub
